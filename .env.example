# Banco local via docker-compose-db.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aventura
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_PORT=27017

# Backend .NET
JWT_KEY=replace_with_a_local_jwt_key_with_at_least_32_chars

# Compatibilidade com DbRunner e ambientes remotos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aventura
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Serviço de inferência / configuração .NET por variável de ambiente
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aventura;Username=postgres;Password=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aventura
