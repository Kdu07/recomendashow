<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>BackEnd.Aventura.IntegrationTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk"           Version="17.9.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="Npgsql"                           Version="10.0.2" />
    <PackageReference Include="Testcontainers.PostgreSql"        Version="3.10.0" />
    <PackageReference Include="Respawn"                          Version="6.2.1" />
    <PackageReference Include="WireMock.Net"                     Version="1.6.9" />
    <PackageReference Include="xunit"                            Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio"        Version="2.5.6" />
    <PackageReference Include="FluentAssertions"                 Version="6.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackEnd.Aventura.csproj" />
  </ItemGroup>
</Project>